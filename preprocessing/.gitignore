# Python, environments, build output and temporary files
__pycache__/
_pycache_/
*.py[cod]
.venv/
.env
.env.*
build/
dist/
*.egg-info/
temp/
tmp/
*.temp
*.tmp

# Preserve the runtime skeleton while excluding local data and generated files.
/assets/**
!/assets/**/
!/assets/**/.gitkeep
/cache/**
!/cache/**/
!/cache/**/.gitkeep
/data/**
!/data/**/
!/data/**/.gitkeep
/results/**
!/results/**/
!/results/**/.gitkeep
